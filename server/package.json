{
  "name": "blade-html-language-server",
  "version": "0.1.0",
  "private": true,
  "description": "HTML and web-types (Vue components) language server for Laravel Blade templates",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/blade.test.ts\" \"test/webTypes.test.ts\" \"test/service.test.ts\""
  },
  "dependencies": {
    "vscode-html-languageservice": "5.6.2",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-uri": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
